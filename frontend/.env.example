# Base URL of the auth API. Leave empty to use `/api/auth` on the current origin
# in a production build (the Vercel setup serves both from one domain); in `vite dev`
# an empty value switches the form into mock mode with no backend.
VITE_API_BASE_URL=http://localhost:5000/api/auth
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Apple Services ID (the web client_id). Must match the server APPLE_CLIENT_ID.
# Leave the placeholder to keep Apple sign-in disabled.
VITE_APPLE_CLIENT_ID=your_apple_services_id_here