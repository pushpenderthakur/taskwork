# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/taskwork

# Frontend origin allowed to call this API (CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173

# Token secrets - use long random strings, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Google OAuth (same value as the frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Apple OAuth: the Services ID (web) client_id used by Sign in with Apple.
# Must match the frontend VITE_APPLE_CLIENT_ID.
APPLE_CLIENT_ID=

# Apple token endpoints - only change these for local tests.
APPLE_ISSUER=https://appleid.apple.com
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

# Email delivery (OTP). Optional - without it the code is only logged and
# returned as `devCode` outside production.
#
# Gmail: leave SMTP_HOST empty, set SMTP_USER to the Gmail address and
# SMTP_PASS to an App Password (https://myaccount.google.com/apppasswords).
# Gmail is then detected automatically (smtp.gmail.com:465, implicit TLS).
# For STARTTLS on 587 set SMTP_PORT=587 and SMTP_SECURE=false instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Taskwork <no-reply@taskwork.local>"

# Any nodemailer service name (gmail, outlook, yahoo, ...) instead of host/port.
SMTP_SERVICE=