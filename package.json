{
  "name": "taskwork",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "npm --prefix frontend run dev",
    "dev:server": "npm --prefix backend run dev",
    "dev:all": "npm run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint",
    "preview": "npm --prefix frontend run preview",
    "test:api": "npm --prefix backend run test:smoke",
    "test:ui": "node frontend/scripts/ui-check.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:dev": "npm --prefix backend run db:dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}