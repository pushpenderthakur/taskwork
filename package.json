{
  "name": "taskwork",
  "private": true,
  "scripts": {
    "dev": "npm --prefix taskwork run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "concurrently -n web,api -c blue,green \"npm run dev\" \"npm run dev:server\"",
    "build": "npm --prefix taskwork run build",
    "lint": "npm --prefix taskwork run lint",
    "preview": "npm --prefix taskwork run preview",
    "test:api": "npm --prefix server run test:smoke",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:dev": "npm --prefix server run db:dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}